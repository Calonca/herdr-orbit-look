#!/usr/bin/env bash
# A throwaway herdr-app on its own core, home and headless display, so the
# layouts, themes and mods here get tried without touching the real app, its
# config or the desktop. Adapted from herdr-app's own scripts/sandbox, but it
# runs the installed herdr-app (no build) and never sends telemetry.
#
# The display is headless sway on the GPU, in a runtime directory of its own,
# with no X server; it needs sway and a render node (/dev/dri/renderD*), and
# does not fall back to drawing in software. SANDBOX_WIDTH and SANDBOX_HEIGHT
# are its size in pixels (1600x1000), SANDBOX_SCALE its scale (1).
#
#   scripts/sandbox up            start the display, the core and the window, install this repo
#   scripts/sandbox restart       restart the window (terminals live on)
#   scripts/sandbox do <action> [json] | status | ls | check <dir>   drive it
#   scripts/sandbox input <command>...   its mouse and keyboard, in logical pixels:
#       mousemove X Y | mousedown [B] | mouseup [B] | click [B] | type TEXT |
#       key KEY | keydown KEY | keyup KEY | sleep SECONDS  (scripts/sandbox-input)
#   scripts/sandbox size W H      the window's size, in logical pixels, at the top left
#   scripts/sandbox size full     the window fills the display again
#   scripts/sandbox shot [file]   the window's own last frame (herdr-app shot)
#   scripts/sandbox clipboard     the text on its clipboard (needs wl-clipboard)
#   scripts/sandbox log           the window's log
#   scripts/sandbox hc <args>     hc against the sandbox core
#   scripts/sandbox down          stop everything and delete it
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/.." && pwd)
name=${HERDR_APP_SANDBOX:-mods}
root=/var/tmp/herdr-app-$name
bin=${HERDR_APP_BIN:-$(command -v herdr-app)}
export HC_SESSION=herdr-app-$name HERDR_APP_HOME=$root/home XDG_STATE_HOME=$root/state
export HERDR_APP_NO_SOUND=1 DO_NOT_TRACK=1 HERDR_TELEMETRY=0
# Every path and socket of the display: the person's own is never in reach.
export XDG_RUNTIME_DIR=$root/run WAYLAND_DISPLAY=wayland-1 SWAYSOCK=$root/run/sway.sock
unset DISPLAY HC_TERMINAL_ID HC_TERMINAL_SOCKET
input=$root/run/input.sock
width=${SANDBOX_WIDTH:-1600} height=${SANDBOX_HEIGHT:-1000} scale=${SANDBOX_SCALE:-1}

ours() { { tr '\0' '\n' <"/proc/$1/environ"; } 2>/dev/null | grep -qx "HERDR_APP_HOME=$HERDR_APP_HOME"; }

# The sandbox's sway, if it runs: by its command line, since its environment is
# not readable (it has a file capability).
display_pid() {
  local pid
  pid=$(cat "$root/display.pid" 2>/dev/null) || return 1
  { tr '\0' ' ' <"/proc/$pid/cmdline"; } 2>/dev/null | grep -qF -- "sway -c $root/sway.conf " && echo "$pid"
}

make_home() {
  local h=$root/userhome
  mkdir -p "$h/.local/bin" "$h/.local/share" "$h/.config" "$h/.cache"
  # herdr-app's own files (a launcher in ~/.local/bin may start it from there).
  [[ -d $HOME/.local/share/herdr-app ]] && ln -sfn "$HOME/.local/share/herdr-app" "$h/.local/share/herdr-app"
  [[ -e $h/.zshrc ]] || echo "# sandbox" >"$h/.zshrc"
  [[ -e $HOME/.local/bin/wasm-mods-host ]] && ln -sfn "$HOME/.local/bin/wasm-mods-host" "$h/.local/bin/wasm-mods-host"
  [[ -d $HOME/.config/wasm-mods && ! -e $h/.config/wasm-mods ]] && cp -r "$HOME/.config/wasm-mods" "$h/.config/wasm-mods"
  if [[ -d $HOME/.local/share/wasm-mods/modules && ! -e $h/.local/share/wasm-mods/modules ]]; then
    mkdir -p "$h/.local/share/wasm-mods"
    cp -r "$HOME/.local/share/wasm-mods/modules" "$h/.local/share/wasm-mods/modules"
  fi
  return 0
}

start_display() {
  if display_pid >/dev/null; then return 0; fi
  command -v sway >/dev/null || { echo "the sandbox's display needs sway" >&2; return 1; }
  local node gpu=
  for node in /dev/dri/renderD*; do [[ -r $node && -w $node ]] && gpu=$node && break; done
  [[ -n $gpu ]] || { echo "the sandbox needs the GPU: no /dev/dri/renderD* to open here (it does not draw in software)" >&2; return 1; }
  mkdir -p "$root"
  mkdir -p -m 700 "$XDG_RUNTIME_DIR"
  rm -f "$XDG_RUNTIME_DIR"/wayland-* "$SWAYSOCK" "$input"
  local w h
  w=$(awk "BEGIN { print int($width / $scale) }") h=$(awk "BEGIN { print int($height / $scale) }")
  # The helper that holds the mouse and the keyboard lives as long as sway.
  cat >"$root/sway.conf" <<CONF
xwayland disable
swaybg_command -
output HEADLESS-1 resolution ${width}x${height} scale $scale
default_border none
default_floating_border none
focus_follows_mouse no
exec "$here/sandbox-input" serve "$input" $w $h
CONF
  WLR_BACKENDS=headless WLR_RENDERER=gles2 WLR_RENDER_DRM_DEVICE=$gpu WLR_LIBINPUT_NO_DEVICES=1 \
    setsid sway -c "$root/sway.conf" >"$root/sway.log" 2>&1 </dev/null &
  echo $! >"$root/display.pid"
  for _ in $(seq 100); do
    [[ -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY && -S $input ]] && return 0
    kill -0 "$(cat "$root/display.pid")" 2>/dev/null || break
    sleep 0.1
  done
  echo "the sandbox display did not start; see $root/sway.log:" >&2
  tail -5 "$root/sway.log" >&2
  return 1
}

stop_window() {
  [[ -f $root/pid ]] || return 0
  local pid
  pid=$(cat "$root/pid")
  if ours "$pid"; then
    kill "$pid"
    # Gone, not just going (its environment goes first): a new window would
    # find this one and leave.
    for _ in $(seq 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
  fi
  rm -f "$root/pid"
}

on_gpu() {
  # (A window that draws in software has no render node open.)
  for _ in $(seq 20); do
    readlink "/proc/$(cat "$root/pid")"/fd/* 2>/dev/null | grep -q '^/dev/dri/renderD' && return 0
    sleep 0.1
  done
  echo "sandbox $name: the window is not drawing on the GPU; see $root/app.log" >&2
  return 1
}

start_window() {
  start_display
  mkdir -p "$HERDR_APP_HOME" "$root/bin"
  for opener in xdg-open open; do
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" >>%q\n' "$root/opened" >"$root/bin/$opener"
    chmod +x "$root/bin/$opener"
  done
  HERDR_APP_HOME=$HERDR_APP_HOME "$repo/install.sh" >/dev/null
  # Skip the first-run welcome: it would cover every screenshot.
  [[ -f $HERDR_APP_HOME/shared.json ]] || echo '{"frame.welcomed":"skipped","layout":"orbit"}' >"$HERDR_APP_HOME/shared.json"
  make_home
  env HOME="$root/userhome" PATH="$root/bin:$PATH" setsid "$bin" >"$root/app.log" 2>&1 </dev/null &
  echo $! >"$root/pid"
  for _ in $(seq 100); do
    "$bin" status >/dev/null 2>&1 && { on_gpu && echo "sandbox $name is up (home: $HERDR_APP_HOME)"; return; }
    kill -0 "$(cat "$root/pid")" 2>/dev/null || { cat "$root/app.log"; echo "sandbox $name died" >&2; return 1; }
    sleep 0.2
  done
  echo "sandbox $name did not answer; see $root/app.log" >&2
  return 1
}

case ${1:-} in
  up | restart) stop_window; start_window ;;
  down)
    stop_window
    hc server stop >/dev/null 2>&1 || true
    if dp=$(display_pid); then
      kill "$dp"
      for _ in $(seq 50); do kill -0 "$dp" 2>/dev/null || break; sleep 0.1; done
      kill -9 "$dp" 2>/dev/null || true
    fi
    rm -rf "$root"
    echo "sandbox $name is gone"
    ;;
  do | status | ls | check | commands) exec "$bin" "$@" ;;
  shot) exec "$bin" shot "${2:-$root/shot.png}" ;;
  log) cat "$root/app.log" ;;
  hc) shift; exec hc "$@" ;;
  input) shift; exec "$here/sandbox-input" do "$input" "$@" ;;
  size)
    if [[ ${2:-} == full ]]; then swaymsg -q '[all] floating disable'
    else swaymsg -q "[all] floating enable, resize set ${2:?width} px ${3:?height} px, move absolute position 0 px 0 px"; fi
    ;;
  clipboard) exec wl-paste --no-newline ;;
  *) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 2 ;;
esac
